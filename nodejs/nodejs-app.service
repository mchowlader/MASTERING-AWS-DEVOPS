[Unit]
Description=Node.js Application
After=mysql.service
Requires=mysql.service

[Service]
Type=simple
User=nodejs
WorkingDirectory=/opt/app
Environment=PATH=/usr/local/nvm/versions/node/$(nvm version)/bin:$PATH
ExecStart=/usr/local/nvm/versions/node/$(nvm version)/bin/node /opt/app/server.js
Restart=always
RestartSec=10
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target